---
import { getCollection } from 'astro:content';
import PostDate from './PostDate.astro';

interface Props {
  productId?: string;
  limit?: number;
}

const { productId, limit } = Astro.props;
const posts = (await getCollection('blog', ({ data }) =>
  !productId || data.products.some(({ id }) => id === productId),
)).sort((a, b) =>
  b.data.published.localeCompare(a.data.published) || a.id.localeCompare(b.id),
).slice(0, limit);
---
{posts.length > 0 && (
  <div class:list={[{ 'related-posts': productId }]}>
    {productId && <h2>О продукте в блоге</h2>}
    <ul class="post-list">
      {posts.map(({ id, data }) => (
        <li>
          <PostDate date={data.published} />
          <a class="post-title" href={`/blog/${id}/`}>{data.title}</a>
          <p>{data.description}</p>
        </li>
      ))}
    </ul>
  </div>
)}
